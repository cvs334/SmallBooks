<Project Sdk="Microsoft.NET.Sdk">
  <!-- EF Core + SQLite storage, the posting service, company files, the module host and backups. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmallBooks.Modules.Abstractions\SmallBooks.Modules.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(ExtensionsVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The made-up sample company; samples/tools/make_bank_files.py reads the same file. -->
    <EmbeddedResource Include="Samples\sample-books.json" LogicalName="SmallBooks.Data.Samples.sample-books.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SmallBooks.Tests" />
  </ItemGroup>
</Project>
