<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- The Windows app: a .NET MAUI window hosting the SmallBooks screens in a
       BlazorWebView. Almost all code lives in the other projects; this one only
       starts the app, picks the modules and handles Windows-specific bits. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SmallBooks.Desktop</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>SmallBooks</ApplicationTitle>
    <ApplicationId>com.smallbooks.desktop</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Unpackaged: F5 runs it straight away, no MSIX or certificate needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- MAUI version for the net10.0 target. Pinned so a newer SDK in Visual Studio
         doesn't pull a MAUI release meant for a newer .NET. -->
    <SmallBooksMauiVersion>10.0.130</SmallBooksMauiVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F6F62" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F6F62" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(SmallBooksMauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(SmallBooksMauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="$(ExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmallBooks.Shell\SmallBooks.Shell.csproj" />
    <ProjectReference Include="..\Modules\SmallBooks.Modules.Reports\SmallBooks.Modules.Reports.csproj" />
  </ItemGroup>
</Project>
