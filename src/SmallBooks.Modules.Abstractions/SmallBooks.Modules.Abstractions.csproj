<Project Sdk="Microsoft.NET.Sdk">
  <!-- The contract between the app and its modules. A module references this
       project (and Ui.Shared for screens) and nothing else from SmallBooks. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmallBooks.Core\SmallBooks.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(ExtensionsVersion)" />
  </ItemGroup>
</Project>
